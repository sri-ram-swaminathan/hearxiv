{
  "manifest_version": 3,
  "name": "hearxiv - listen to arXiv papers",
  "version": "0.0.1",
  "description": "Voice-first, interactive audio for arXiv papers. Free and open source.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:8765/*"],
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://arxiv.org/html/*",
        "https://arxiv.org/pdf/*",
        "https://www.alphaxiv.org/abs/*",
        "https://alphaxiv.org/abs/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
