{
  "manifest_version": 3,
  "name": "hearxiv - listen to arXiv papers",
  "version": "0.0.1",
  "description": "Adds a 'Listen' button to arXiv and alphaXiv papers that opens the hearxiv voice app.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://arxiv.org/html/*",
        "https://arxiv.org/pdf/*",
        "https://www.alphaxiv.org/abs/*",
        "https://alphaxiv.org/abs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}